# What `cargo xtask ship 10-tetris` assembles a folder from (§6 M41). Every name
# here is the name the file has *in the folder*, so shipping is a copy — except
# `game`, which is absent on purpose: a dylib is `.dll` on one host and `lib….so`
# on another, so the folder's own manifest names it and this one cannot.
#
# The title is the operator's, not the tree's: this is a demo of a falling-block
# game and stays one in `demos/`, but the mark on the obvious name is enforced by
# the company that holds it, so what ships says something else.
input  = input.toml
# The clips (§6 M43). Named here because M41's gate refuses a demo that has an
# `assets/` tree and a manifest that does not — a game shipping without its pack
# is one that opens silent, three layers from anything that says so.
pack   = clips.ggpack
title  = Falling Blocks
# What build this is (§6 M73). It reaches the zip's name, the startup log, the
# crash report and the executable's own version resource — which is the Details
# tab a player reads and the only one of the four they can reach without opening
# anything. A demo nobody has released may leave it out; this one is released.
version = 0.1.0
# Twice the 640x360 canvas the game lays its board out in, so every widget lands
# on a whole pixel.
window = 1280x720
# The taskbar picture (§6 M46), written by `cargo run -p gg-tools -- icon` out of
# this game's own SHAPES and COLORS. Raw RGBA behind an eight-byte header, since
# deny.toml keeps every image decoder out of the dist graph and a window wants
# its icon before the pack is open.
icon   = icon.ggicon
